{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cspcombine container specification",
  "description": "Спецификация для: cspcombine create spec.json",
  "type": "object",
  "properties": {
    "provider": {
      "description": "Криптопровайдер. Если не указан, определяется по остальным полям.",
      "enum": ["vipnet", "cryptopro"]
    },
    "private_key": {
      "description": "PEM PKCS#8, путь к PEM или hex-скаляр. Если не указан — ключ генерируется.",
      "type": "string"
    },
    "private_key_file": {
      "description": "Альтернативное имя для пути к файлу ключа.",
      "type": "string"
    },
    "pin": {
      "description": "PIN. Пустая строка — без пароля; отсутствие поля — сгенерировать.",
      "type": ["string", "integer", "null"]
    },
    "algorithm": {
      "description": "Алгоритм ГОСТ.",
      "enum": ["2001", "2012-256", "2012-512", "gost2001", "gost2012-256", "gost2012-512"]
    },
    "curve": {
      "description": "OID кривой, например 1.2.643.2.2.36.0 или 1.2.643.7.1.2.1.1.1.",
      "type": "string"
    },
    "curve_oid": {
      "description": "Алиас для curve.",
      "type": "string"
    },
    "digest": {
      "description": "OID хэша или 2001/2012-256/2012-512.",
      "type": "string"
    },
    "valid_from": {
      "description": "Начало действия: YYYY-MM-DD или ISO 8601.",
      "type": "string"
    },
    "valid_until": {
      "description": "Окончание действия: YYYY-MM-DD или ISO 8601.",
      "type": "string"
    },
    "container_name": {
      "description": "Имя контейнера (name.key в КриптоПро).",
      "type": "string",
      "default": "cspcombine"
    },
    "iterations": {
      "description": "Количество итераций PBKDF2 для ViPNet.",
      "type": "integer",
      "minimum": 1,
      "default": 2000
    },
    "key_length": {
      "description": "Длина ключа PBKDF2 для ViPNet (сейчас поддерживается только 32).",
      "type": "integer",
      "enum": [32],
      "default": 32
    },
    "salt": {
      "description": "Hex или auto (ViPNet).",
      "type": "string",
      "default": "auto"
    },
    "iv": {
      "description": "Hex или auto (ViPNet).",
      "type": "string",
      "default": "auto"
    },
    "version": {
      "description": "Версия заголовка контейнера ViPNet.",
      "type": "integer",
      "default": 16
    },
    "entry_version": {
      "description": "Версия записи ViPNet.",
      "type": "integer",
      "default": 3
    },
    "serial_number": {
      "description": "16 байт hex или auto (ViPNet).",
      "type": "string",
      "default": "auto"
    },
    "key_uid": {
      "description": "32 байта hex или auto (ViPNet).",
      "type": "string",
      "default": "auto"
    },
    "native_profile": {
      "description": "Добавить нативный профиль ViPNet.",
      "type": "boolean",
      "default": false
    },
    "key_class": {
      "type": "integer",
      "default": 1
    },
    "key_type": {
      "type": "integer",
      "default": 43590
    },
    "flags": {
      "type": "integer",
      "default": 1
    },
    "defence": {
      "type": "object",
      "properties": {
        "key_class": {"type": "integer", "default": 1024},
        "key_type": {"type": "integer", "default": 32826},
        "flags": {"type": "integer", "default": 0}
      },
      "additionalProperties": false
    },
    "certificate": {
      "description": "PEM, hex или путь к DER-сертификату (КриптоПро).",
      "type": "string"
    },
    "certificate_der": {
      "description": "Алиас для certificate.",
      "type": "string"
    },
    "key_usage": {
      "description": "Назначение ключа КриптоПро.",
      "enum": ["sign", "exchange"],
      "default": "sign"
    },
    "extension_oid": {
      "description": "Явный OID расширения срока действия (КриптоПро).",
      "type": "string"
    },
    "backup_key": {
      "description": "Создавать masks2.key/primary2.key (КриптоПро).",
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": true
}
