#!/usr/bin/env python3
"""Single entry point for cspcombine."""

from __future__ import annotations

import sys
from pathlib import Path

# Allow running the script directly from the project directory without
# installing anything.  The package itself only uses the Python standard
# library.  In a PyInstaller bundle the package is already on sys.path.
if not getattr(sys, "frozen", False):
    sys.path.insert(0, str(Path(__file__).resolve().parent))

from cspcombine_lib.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
